# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored - it will never be committed.
# Add the same names + values again in Vercel: Project Settings -> Environment Variables.

# Pesepay - sandbox credentials while building, swap to production before launch
PESEPAY_INTEGRATION_KEY=
PESEPAY_ENCRYPTION_KEY=
PESEPAY_ENV=sandbox
# Optional - the code already defaults to Pesepay's confirmed sandbox/production
# URLs (from developers.pesepay.com/api-reference). Only set these if Pesepay
# changes them or your account uses different ones.
PESEPAY_INITIATE_URL_SANDBOX=
PESEPAY_INITIATE_URL_PRODUCTION=
PESEPAY_CHECK_STATUS_URL_SANDBOX=
PESEPAY_CHECK_STATUS_URL_PRODUCTION=

# Random secret shared with Vercel Cron - protects /api/cron/renewal-reminders
# from being triggered by anyone who finds the URL. Generate any random string.
CRON_SECRET=
# Fallback only - used when Pesepay's initiate response doesn't include a
# pollUrl. Confirm the exact check-status endpoint in your dashboard.
PESEPAY_CHECK_STATUS_URL_SANDBOX=
PESEPAY_CHECK_STATUS_URL_PRODUCTION=

# Public site URL - used to build resultUrl/returnUrl sent to Pesepay
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Vercel KV - create a KV store in the Vercel dashboard, it auto-fills these
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Resend - for the contact form and any transactional email (license key delivery)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Product price in USD, used to build the checkout payload
LICENSE_PRICE_USD=149
